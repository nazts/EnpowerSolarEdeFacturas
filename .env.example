# Copiar a .env y completar con las credenciales reales
EDENORTE_URL=https://ofv.edenorte.com.do
EDENORTE_EMAIL=
EDENORTE_PASSWORD=

# Edesur (Oficina Virtual) - API ovapi.edesur.com.do
EDESUR_USER=
EDESUR_PASSWORD=

# Base de datos:
#   vacio            -> SQLite local (data/enpower.db)
#   postgresql://... -> Postgres de Supabase (usar el Transaction pooler, puerto 6543)
DATABASE_URL=

# Bot de Telegram (BotFather) y canal destino
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoreo solar Noor/Weco (plantas de los clientes)
NOOR_USUARIO=
NOOR_CLAVE=

# Rutas de trabajo (relativas al proyecto)
DB_PATH=data/enpower.db
FACTURAS_DIR=facturas
EXPORT_DIR=exports

# Sesiones y usuario administrador inicial
SECRET_KEY=
ADMIN_USER=admin
ADMIN_PASSWORD=

# Reloj interno del panel (corre la descarga a las 07:00 si el timer no lo hizo).
# Poner en 0 para desactivarlo.
ENPOWER_AGENDA=1

# Cotizaciones: plantilla de la empresa y firma opcional en PNG (fondo transparente).
# Si no hay PNG, el PDF sale solo con la línea para firmar a mano.
COTIZACION_PLANTILLA=app/static/plantillas/cotizacion.pdf
