# Copiar a .env y completar con las credenciales reales
EDENORTE_URL=https://ofv.edenorte.com.do
EDENORTE_EMAIL=
EDENORTE_PASSWORD=

# Edesur (Oficina Virtual) - API ovapi.edesur.com.do
EDESUR_USER=
EDESUR_PASSWORD=

# Base de datos:
#   vacio            -> SQLite local (data/enpower.db)
#   postgresql://... -> Postgres de Supabase (usar el Transaction pooler, puerto 6543)
DATABASE_URL=

# Bot de Telegram (BotFather) y canal destino
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rutas de trabajo (relativas al proyecto)
DB_PATH=data/enpower.db
FACTURAS_DIR=facturas
EXPORT_DIR=exports

# Sesiones y usuario administrador inicial
SECRET_KEY=
ADMIN_USER=admin
ADMIN_PASSWORD=
